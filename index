let audioRepeatRemaining=0,currentPlayingVerseEl=null,currentPlayingVerseNum=0,currentPlayingSurahNum=0;
let currentFilter='all',currentFilterEncyclopedia='all';
let quizMode=null,quizQuestions=[],quizIndex=0,quizCorrect=0,quizWrong=0,quizScore=0,quizTimer=null,quizTimeLeft=0,quizAnswersLog=[];
