// ============ الاختبارات ============
function selectQuizMode(mode){
  quizMode=mode;
  ['kids','surah','full'].forEach(m=>{const el=document.getElementById('mode'+(m==='kids'?'Kids':m==='surah'?'Surah':'Full'));if(el)el.classList.toggle('selected',m===mode);});
  document.getElementById('surahSelectWrap').style.display=mode==='surah'?'block':'none';
  if(mode==='surah')populateSurahSelect();
}
function populateSurahSelect(){
  const sel=document.getElementById('quizSurahSelect');if(!sel)return;
  sel.innerHTML='<option value="">-- اختر سورة --</option>';
  SURAHS_META.forEach(s=>{const opt=document.createElement('option');opt.value=s.num;opt.textContent=`سورة ${s.name}`;sel.appendChild(opt);});
}
function generateSurahQuestions(meta){
  const qs=[];
  for(let i=0;i<4;i++){
    qs.push({q:`كم عدد آيات سورة ${meta.name}؟`,options:[meta.verses,meta.verses+5,meta.verses-3,meta.verses+10].filter(n=>n>0).map(String).slice(0,4),correct:0});
    qs.push({q:`سورة ${meta.name} سورة...`,options:['مكية','مدنية'],correct:meta.type==='مكية'?0:1});
  }
  qs.push({q:`ما رقم سورة ${meta.name}؟`,options:[meta.num,meta.num+5,meta.num-3,meta.num+10].filter(n=>n>0&&n<=114).map(String).slice(0,4),correct:0});
  qs.push({q:`في أي جزء؟`,options:[String(meta.juz),String(Math.min(30,meta.juz+3)),String(Math.max(1,meta.juz-3))],correct:0});
  const shuffled=qs.map(q=>{const correctAns=q.options[q.correct];const opts=[...q.options].sort(()=>Math.random()-0.5);return {q:q.q,options:opts,correct:opts.indexOf(correctAns)};});
  return shuffled.sort(()=>Math.random()-0.5).slice(0,10);
}
function generateFullQuiz(){
  const pool=[];const shuffled=[...SURAHS_META].sort(()=>Math.random()-0.5);
  shuffled.slice(0,15).forEach(s=>{const opts=[String(s.verses),String(s.verses+5),String(s.verses-2),String(s.verses+10)].sort(()=>Math.random()-0.5);pool.push({q:`كم عدد آيات سورة ${s.name}؟`,options:opts,correct:opts.indexOf(String(s.verses))});});
  shuffled.slice(0,10).forEach(s=>{pool.push({q:`سورة ${s.name} سورة...`,options:['مكية','مدنية'],correct:s.type==='مكية'?0:1});});
  shuffled.slice(0,5).forEach(s=>{const opts=[s.name,...SURAHS_META.filter(x=>x.num!==s.num).sort(()=>Math.random()-0.5).slice(0,3).map(x=>x.name)].sort(()=>Math.random()-0.5);pool.push({q:`ما السورة التي ترتيبها ${s.num}؟`,options:opts,correct:opts.indexOf(s.name)});});
  return pool.sort(()=>Math.random()-0.5).slice(0,30);
}
function startQuiz(){
  if(!quizMode){showToast('⚠️ اختر نوع الاختبار');return;}
  if(quizMode==='kids'){startKidsQuiz();return;}
  if(quizMode==='surah'){const num=parseInt(document.getElementById('quizSurahSelect').value);if(!num){showToast('⚠️ اختر سورة');return;}const meta=SURAHS_META.find(s=>s.num===num);quizQuestions=generateSurahQuestions(meta);}
  else{quizQuestions=generateFullQuiz();}
  quizIndex=0;quizCorrect=0;quizWrong=0;quizScore=0;quizAnswersLog=[];
  document.getElementById('quizSetup').style.display='none';
  document.getElementById('quizPlay').style.display='block';
  document.getElementById('kidsQuizPlay').style.display='none';
  document.getElementById('quizResults').style.display='none';
  document.getElementById('timerBadge').style.display='';
  updateQuizStats();showQuizQuestion();
}
function startQuizTimer(){
  if(quizTimer)clearInterval(quizTimer);quizTimeLeft=30;updateTimerUI();
  quizTimer=setInterval(()=>{quizTimeLeft--;updateTimerUI();if(quizTimeLeft<=0){clearInterval(quizTimer);quizTimer=null;document.querySelectorAll('.quiz-option').forEach(b=>b.disabled=true);const q=quizQuestions[quizIndex];quizAnswersLog.push({question:q.q,correct:q.options[q.correct],chosen:'⏰ لم يجب',isCorrect:false});quizWrong++;quizScore=Math.max(0,quizScore-3);updateQuizStats();document.querySelectorAll('.quiz-option').forEach((b,i)=>{if(i===q.correct)b.classList.add('correct');});showToast('⏰ انتهى الوقت!');setTimeout(()=>{quizIndex++;showQuizQuestion();},1600);}},1000);
}
function updateTimerUI(){safeSetText('quizTimer',quizTimeLeft);}
function updateQuizStats(){safeSetText('quizCorrect',quizCorrect);safeSetText('quizWrong',quizWrong);safeSetText('quizScore',quizScore);}
function showQuizQuestion(){
  if(quizIndex>=quizQuestions.length){endQuiz();return;}
  const q=quizQuestions[quizIndex];
  safeSetText('quizQuestion',q.q);safeSetText('quizProgress',`السؤال ${quizIndex+1} من ${quizQuestions.length}`);
  const opts=document.getElementById('quizOptions');opts.innerHTML='';
  q.options.forEach((opt,idx)=>{const btn=document.createElement('button');btn.className='quiz-option';btn.textContent=opt;btn.onclick=()=>answerQuiz(btn,idx,q);opts.appendChild(btn);});
  startQuizTimer();
}
function answerQuiz(btn,chosen,q){
  if(quizTimer){clearInterval(quizTimer);quizTimer=null;}
  document.querySelectorAll('.quiz-option').forEach(b=>b.disabled=true);
  const isCorrect=chosen===q.correct;
  quizAnswersLog.push({question:q.q,correct:q.options[q.correct],chosen:q.options[chosen],isCorrect});
  if(isCorrect){btn.classList.add('correct');quizCorrect++;quizScore+=10;showToast('🎉 أحسنت!');}
  else{btn.classList.add('wrong');quizWrong++;quizScore=Math.max(0,quizScore-3);showToast('❌ حاول مرة أخرى');document.querySelectorAll('.quiz-option').forEach((b,i)=>{if(i===q.correct)b.classList.add('correct');});}
  updateQuizStats();setTimeout(()=>{quizIndex++;showQuizQuestion();},1600);
}
function endQuiz(){
  if(quizTimer){clearInterval(quizTimer);quizTimer=null;}
  document.getElementById('quizPlay').style.display='none';
  document.getElementById('quizResults').style.display='block';
  const total=quizQuestions.length;const percent=total>0?Math.round((quizCorrect/total)*100):0;
  document.getElementById('resultEmoji').textContent=percent>=90?'🏆':percent>=70?'🥈':percent>=50?'🥉':'📚';
  document.getElementById('resultSummary').innerHTML=`النتيجة: <span style="color:var(--teal);">${quizCorrect} / ${total}</span> (${percent}%)<br>النقاط: <span style="color:var(--gold);">${quizScore}</span>`;
  let html='<div style="text-align:right; background:rgba(212,175,55,.08); padding:15px; border-radius:12px; max-height:400px; overflow-y:auto;"><h4 style="margin-bottom:10px; font-family:Amiri,serif;">📝 نموذج الإجابة:</h4>';
  quizAnswersLog.forEach((a,i)=>{html+=`<div style="margin-bottom:10px; padding:8px; background:${a.isCorrect?'rgba(6,214,160,.15)':'rgba(239,71,111,.15)'}; border-radius:8px; font-size:.9rem;"><strong>${i+1}. ${a.question}</strong><br>✅ ${a.correct}${!a.isCorrect?`<br>❌ ${a.chosen}`:''}</div>`;});
  html+='</div>';
  document.getElementById('resultAnswerModel').innerHTML=html;
  if(percent>=70){launchConfetti();playHappyMelody();}
}
function resetQuiz(){
  if(quizTimer){clearInterval(quizTimer);quizTimer=null;}
  quizMode=null;quizQuestions=[];quizIndex=0;quizCorrect=0;quizWrong=0;quizScore=0;quizAnswersLog=[];
  kidsQuestions=[];kidsIndex=0;kidsCorrect=0;kidsWrong=0;kidsScore=0;kidsAnswersLog=[];
  document.getElementById('quizSetup').style.display='block';
  document.getElementById('quizPlay').style.display='none';
  document.getElementById('kidsQuizPlay').style.display='none';
  document.getElementById('quizResults').style.display='none';
  ['kids','surah','full'].forEach(m=>{const el=document.getElementById('mode'+(m==='kids'?'Kids':m==='surah'?'Surah':'Full'));if(el)el.classList.remove('selected');});
  document.getElementById('surahSelectWrap').style.display='none';
  updateQuizStats();
}
function startKidsQuiz(){
  kidsQuestions=[...KIDS_QUIZ_POOL].sort(()=>Math.random()-0.5).slice(0,10);
  kidsIndex=0;kidsCorrect=0;kidsWrong=0;kidsScore=0;kidsAnswersLog=[];
  document.getElementById('quizSetup').style.display='none';
  document.getElementById('quizPlay').style.display='none';
  document.getElementById('kidsQuizPlay').style.display='block';
  document.getElementById('quizResults').style.display='none';
  updateKidsStats();showKidsQuestion();
}
function updateKidsStats(){safeSetText('kidsCorrect',kidsCorrect);safeSetText('kidsWrong',kidsWrong);safeSetText('kidsScore',kidsScore);}
function showKidsQuestion(){
  if(kidsIndex>=kidsQuestions.length){endKidsQuiz();return;}
  const q=kidsQuestions[kidsIndex];
  safeSetText('kidsEmoji',q.emoji);safeSetText('kidsQuestion',q.q);
  safeSetText('kidsProgress',`السؤال ${kidsIndex+1} من ${kidsQuestions.length}`);
  const opts=document.getElementById('kidsOptions');opts.innerHTML='';
  q.options.forEach((opt,idx)=>{const btn=document.createElement('button');btn.className='kids-option';btn.textContent=opt;btn.onclick=()=>answerKids(btn,idx,q);opts.appendChild(btn);});
