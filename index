// ============ أدوات ============
function safeSetText(id,text){const el=document.getElementById(id);if(el)el.textContent=text;}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function showToast(msg){const t=document.getElementById('toast');if(!t)return;t.textContent=msg;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),2500);}

// ============ التبويبات ============
function createTabs(){
  const tabs=[
    {id:'surahs',label:'📖 السور'},
    {id:'quiz',label:'🎯 اختبارات'},
    {id:'plans',label:'📋 خطتي'},
    {id:'orderGame',label:'🔤 ترتيب'},
    {id:'progress',label:'📊 تقدمي'},
    {id:'encyclopedia',label:'📚 موسوعة الحفاظ'},
    {id:'maps',label:'🗺️ خرائط القرآن'}
  ];
  const c=document.getElementById('tabsContainer');if(!c)return;c.innerHTML='';
  tabs.forEach(s=>{
    const t=document.createElement('button');
    t.className='tab'+(s.id===currentSection?' active':'');
    t.dataset.section=s.id;t.textContent=s.label;
    t.onclick=()=>switchSection(s.id);
    c.appendChild(t);
  });
}
function switchSection(section){
  if(section!=='surahView')stopAudio();
  currentSection=section;
  document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.section===section));
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  const target=document.getElementById('section-'+section);if(target)target.classList.add('active');
  if(section==='progress')renderChecklist();
  if(section==='plans')renderPlans();
  if(section==='orderGame'&&!currentOrderVerse)newOrderGame();
  if(section==='encyclopedia')renderEncyclopedia();
  if(section==='maps')renderMaps();
}

// ============ API ============
async function fetchSurah(num){
  try{
    const res=await fetch(`${API_BASE}/surah/${num}/quran-uthmani`);
    const data=await res.json();
    if(data.code!==200)throw new Error('fail');
    return data.data;
  }catch(e){console.error(e);return null;}
}

// ============ السور ============
function renderSurahs(){
  const grid=document.getElementById('surahsGrid');if(!grid)return;grid.innerHTML='';
  const q=document.getElementById('searchSurah')?.value.trim()||'';
  let list=SURAHS_META;
  if(currentFilter!=='all')list=list.filter(s=>s.type===currentFilter);
  if(q)list=list.filter(s=>s.name.includes(q)||String(s.num)===q);
  if(!list.length){grid.innerHTML='<div style="grid-column:1/-1; text-align:center; padding:40px; opacity:.7;">لا توجد نتائج</div>';return;}
  list.forEach(s=>{
    const card=document.createElement('div');
    card.className='surah-card';
    card.innerHTML=`<div class="surah-number">${s.num}</div><div class="juz-badge">جزء ${s.juz}</div><div class="surah-icon">${s.emoji}</div><div class="surah-name">${s.name}</div><div class="surah-info">${s.verses} آية — ${s.type}</div>`;
    card.onclick=()=>openSurah(s.num);
    grid.appendChild(card);
  });
}
function filterSurahs(){renderSurahs();}
function setFilter(f){currentFilter=f;document.querySelectorAll('.filter-btn').forEach(b=>b.classList.toggle('active',b.dataset.filter===f));renderSurahs();}

async function openSurah(num){
  const meta=SURAHS_META.find(s=>s.num===num);if(!meta)return;
  stopAudio();currentSurah=meta;
  const container=document.getElementById('versesContainer');
  container.innerHTML='<div style="text-align:center; padding:40px;"><div class="loading-spinner"></div><div>جاري تحميل السورة...</div></div>';
  safeSetText('viewSurahName',`سورة ${meta.name}`);
  switchSection('surahView');
  document.getElementById('viewSurahMeta').innerHTML=`<span class="meta-badge">📖 ${meta.verses} آية</span><span class="meta-badge">🕌 ${meta.type}</span><span class="meta-badge">#️⃣ ${meta.num}</span><span class="meta-badge">📚 جزء ${meta.juz}</span>`;
  const data=await fetchSurah(num);
  if(!data){container.innerHTML='<div style="text-align:center; padding:40px; color:var(--danger);">⚠️ تعذّر التحميل. تحقق من الإنترنت.</div>';return;}
  currentSurahData=data;container.innerHTML='';
  if(num!==9&&num!==1){const b=document.createElement('div');b.className='bismillah-verse';b.textContent='بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ';container.appendChild(b);}
  data.ayahs.forEach((ayah,i)=>{
    let verseText=ayah.text;
    if(num===1&&i===0)verseText=verseText.replace('بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ','').trim();
    const v=document.createElement('div');v.className='verse';v.dataset.ayah=ayah.numberInSurah;
    const words=verseText.split(/\s+/).filter(Boolean);
    const wordsHtml=words.map(w=>`<span class="word">${escapeHtml(w)}</span>`).join(' ');
    v.innerHTML=`${wordsHtml} <span class="verse-number">${ayah.numberInSurah}</span>`;
    v.onclick=()=>playVerse(num,ayah.numberInSurah,v);
    container.appendChild(v);
  });
}

// ============ الصوت ============
function playHusaryAudio(surahNum,ayahNum,onEnd){
  if(currentAudio){currentAudio.pause();currentAudio.onended=null;currentAudio.onerror=null;currentAudio=null;}
  const s=String(surahNum).padStart(3,'0'),a=String(ayahNum).padStart(3,'0');
  const url=`${AUDIO_BASE_URL}${s}${a}.mp3`;
  const audio=new Audio(url);audio.preload='auto';currentAudio=audio;
  audio.onended=()=>{if(onEnd)onEnd();};
  audio.onerror=()=>{showToast('⚠️ تعذّر تشغيل الصوت');if(onEnd)onEnd();};
  audio.play().catch(()=>{showToast('⚠️ تعذّر تشغيل الصوت');if(onEnd)onEnd();});
  return audio;
}
function stopAudio(){
  isPlayingFullSurah=false;audioRepeatRemaining=0;
  if(currentAudio){currentAudio.pause();currentAudio.currentTime=0;currentAudio.onended=null;currentAudio.onerror=null;currentAudio=null;}
  if(wordHighlightInterval){clearInterval(wordHighlightInterval);wordHighlightInterval=null;}
  document.querySelectorAll('.verse.playing').forEach(v=>v.classList.remove('playing'));
  document.querySelectorAll('.verse .word.active').forEach(w=>w.classList.remove('active'));
  const ind=document.getElementById('playingIndicator');if(ind)ind.classList.remove('active');
}
function startWordHighlight(verseEl,audio){
  if(wordHighlightInterval)clearInterval(wordHighlightInterval);
  const words=verseEl.querySelectorAll('.word');if(!words.length)return;
  const totalChars=Array.from(words).reduce((s,w)=>s+w.textContent.length,0);
  const setup=()=>{
    const dur=audio.duration||3;let cum=0;
    const timings=Array.from(words).map(w=>{const d=(w.textContent.length/totalChars)*dur;const item={start:cum,end:cum+d};cum+=d;return item;});
    wordHighlightInterval=setInterval(()=>{
      if(!audio.duration||audio.paused||!audio.currentTime)return;
      const now=audio.currentTime;
      words.forEach((w,i)=>{if(now>=timings[i].start&&now<timings[i].end)w.classList.add('active');else w.classList.remove('active');});
    },100);
  };
  if(audio.duration&&!isNaN(audio.duration))setup();else audio.addEventListener('loadedmetadata',setup,{once:true});
}
function playVerse(surahNum,ayahNum,verseEl){
  isPlayingFullSurah=false;
  const ind=document.getElementById('playingIndicator');if(ind)ind.classList.remove('active');
  document.querySelectorAll('.verse.playing').forEach(el=>el.classList.remove('playing'));
  document.querySelectorAll('.verse .word.active').forEach(w=>w.classList.remove('active'));
  verseEl.classList.add('playing');
  currentPlayingVerseEl=verseEl;currentPlayingVerseNum=ayahNum;currentPlayingSurahNum=surahNum;
  const repeat=parseInt(document.getElementById('repeatCount').value)||1;audioRepeatRemaining=repeat;
  playVerseLoop();
}
function playVerseLoop(){
  if(audioRepeatRemaining<=0){
    if(currentPlayingVerseEl)currentPlayingVerseEl.classList.remove('playing');
    if(wordHighlightInterval){clearInterval(wordHighlightInterval);wordHighlightInterval=null;}
    document.querySelectorAll('.verse .word.active').forEach(w=>w.classList.remove('active'));
    return;
  }
  audioRepeatRemaining--;
  const audio=playHusaryAudio(currentPlayingSurahNum,currentPlayingVerseNum,()=>{
    if(audioRepeatRemaining>0)playVerseLoop();
    else{if(currentPlayingVerseEl)currentPlayingVerseEl.classList.remove('playing');document.querySelectorAll('.verse .word.active').forEach(w=>w.classList.remove('active'));}
  });
  if(currentPlayingVerseEl)startWordHighlight(currentPlayingVerseEl,audio);
}
function backToSurahs(){stopAudio();switchSection('surahs');}
function playWholeSurah(){
  if(!currentSurah)return;stopAudio();isPlayingFullSurah=true;
  const container=document.getElementById('versesContainer');const verses=container.querySelectorAll('.verse');let index=0;
  const ind=document.getElementById('playingIndicator');if(ind)ind.classList.add('active');
  safeSetText('playingText','🎧 جاري تشغيل السورة كاملة...');
  function playNext(){
    if(!isPlayingFullSurah)return;
    if(index>=verses.length){isPlayingFullSurah=false;if(ind)ind.classList.remove('active');return;}
    verses.forEach(v=>v.classList.remove('playing'));verses[index].classList.add('playing');
    verses[index].scrollIntoView({behavior:'smooth',block:'center'});
    playHusaryAudio(currentSurah.num,index+1,()=>{if(!isPlayingFullSurah)return;index++;playNext();});
  }
  playNext();
}
