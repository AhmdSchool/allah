          </div>
        </div>
      </div>
      <div class="encyclopedia-extract">${escapeHtml(extract)}</div>
      <div class="encyclopedia-actions">
        <a href="${wikiUrl}" target="_blank" class="btn btn-gold">📖 اقرأ الموسوعة كاملة على ويكيبيديا</a>
        <button class="btn btn-teal" onclick="closeEncyclopediaModal(); openSurahFromEncyclopedia(${num})">📗 افتح السورة</button>
      </div>
    `;
    playHappyMelody();
  } catch(e) {
    body.innerHTML = `
      <div class="encyclopedia-header">
        <div class="encyclopedia-image">${meta.emoji}</div>
        <div class="encyclopedia-image-info">
          <div class="encyclopedia-info-grid">
            <div class="encyclopedia-info-item">
              <div class="encyclopedia-info-label">عدد الآيات</div>
              <div class="encyclopedia-info-value">${meta.verses}</div>
            </div>
            <div class="encyclopedia-info-item">
              <div class="encyclopedia-info-label">الترتيب</div>
              <div class="encyclopedia-info-value">${meta.num}</div>
            </div>
            <div class="encyclopedia-info-item">
              <div class="encyclopedia-info-label">الجزء</div>
              <div class="encyclopedia-info-value">${meta.juz}</div>
            </div>
            <div class="encyclopedia-info-item">
              <div class="encyclopedia-info-label">النوع</div>
              <div class="encyclopedia-info-value">${meta.type}</div>
            </div>
          </div>
        </div>
      </div>
      <div class="encyclopedia-extract" style="text-align:center; opacity:0.7;">⚠️ تعذّر جلب المعلومات من ويكيبيديا حاليًا. يمكنك قراءة المقال كاملًا عبر الرابط أدناه.</div>
      <div class="encyclopedia-actions">
        <a href="${wikiUrl}" target="_blank" class="btn btn-gold">📖 اقرأ الموسوعة كاملة على ويكيبيديا</a>
        <button class="btn btn-teal" onclick="closeEncyclopediaModal(); openSurahFromEncyclopedia(${num})">📗 افتح السورة</button>
      </div>
    `;
