}

function closeEncyclopediaModal(){document.getElementById('encyclopediaModal').classList.remove('show');}
document.getElementById('encyclopediaModal')?.addEventListener('click',function(e){if(e.target===this)closeEncyclopediaModal();});
function openSurahFromEncyclopedia(num){switchSection('surahs');setTimeout(()=>openSurah(num),100);}

// ============ الخرائط ============
function renderMaps(){
  const grid=document.getElementById('mapsGrid');if(!grid)return;grid.innerHTML='';
  const q=document.getElementById('searchMap')?.value.trim()||'';
  let list=SURAHS_META;
  if(q)list=list.filter(s=>s.name.includes(q)||String(s.num)===q);
  list.forEach(s=>{
    const hasMap=!!MIND_MAPS[s.num];
    const card=document.createElement('div');
    card.className='map-card '+(hasMap?'available':'unavailable');
    card.innerHTML=`<div class="map-card-num">${s.num}</div><div class="map-card-icon">${s.emoji}</div><div class="map-card-name">${s.name}</div><div class="map-card-status">${hasMap?'🗺️ متاحة':'⏳ قريباً'}</div>`;
    card.onclick=()=>openMapModal(s.num);
    grid.appendChild(card);
  });
}
function filterMaps(){renderMaps();}
function buildMindMapSVG(map){
  const w=900,h=600,cx=w/2,cy=h/2;const nb=map.branches.length;const radius=180,subRadius=90;
  let svg=`<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg" style="font-family: 'Amiri', serif;">`;
  svg+=`<defs><linearGradient id="centerGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:${map.color1};stop-opacity:1"/><stop offset="100%" style="stop-color:${map.color2};stop-opacity:1"/></linearGradient></defs>`;
  for(let i=0;i<nb;i++){const a=(i/nb)*2*Math.PI-Math.PI/2;const bx=cx+Math.cos(a)*radius,by=cy+Math.sin(a)*radius;svg+=`<line x1="${cx}" y1="${cy}" x2="${bx}" y2="${by}" stroke="${map.color1}" stroke-width="3" opacity="0.6"/>`;}
  svg+=`<circle cx="${cx}" cy="${cy}" r="75" fill="url(#centerGrad)" stroke="#fff" stroke-width="4"/>`;
  svg+=`<text x="${cx}" y="${cy-12}" text-anchor="middle" font-size="36" fill="#fff">${map.center.emoji}</text>`;
  svg+=`<text x="${cx}" y="${cy+15}" text-anchor="middle" font-size="22" font-weight="bold" fill="#1a2b4c">${map.center.name}</text>`;
  svg+=`<text x="${cx}" y="${cy+38}" text-anchor="middle" font-size="13" fill="#1a2b4c" opacity="0.8">${map.center.sub}</text>`;
  for(let i=0;i<nb;i++){
    const a=(i/nb)*2*Math.PI-Math.PI/2;const bx=cx+Math.cos(a)*radius,by=cy+Math.sin(a)*radius;
    const children=map.branches[i].children||[];
    children.forEach((ch,ci)=>{const ca=a+(ci-(children.length-1)/2)*0.3;const sx=bx+Math.cos(ca)*subRadius,sy=by+Math.sin(ca)*subRadius;svg+=`<line x1="${bx}" y1="${by}" x2="${sx}" y2="${sy}" stroke="${map.color2}" stroke-width="2" opacity="0.5"/>`;const anchor=sx>cx+20?'start':(sx<cx-20?'end':'middle');svg+=`<text x="${sx}" y="${sy+5}" text-anchor="${anchor}" font-size="12" fill="${map.color1}" font-weight="bold">${ch}</text>`;});
    svg+=`<circle cx="${bx}" cy="${by}" r="42" fill="${map.color1}" stroke="#fff" stroke-width="3"/>`;
    svg+=`<text x="${bx}" y="${by-5}" text-anchor="middle" font-size="24" fill="#fff">${map.branches[i].emoji}</text>`;
    svg+=`<text x="${bx}" y="${by+18}" text-anchor="middle" font-size="13" font-weight="bold" fill="#fff">${map.branches[i].name}</text>`;
  }
  svg+='</svg>';return svg;
}
function openMapModal(num){
  const modal=document.getElementById('mapModal');const title=document.getElementById('mapTitle');const body=document.getElementById('mapBody');
  const surah=SURAHS_META.find(s=>s.num===num);if(!surah)return;
  if(MIND_MAPS[num]){const map=MIND_MAPS[num];title.textContent=map.title;body.innerHTML=`<div class="map-svg-container" id="currentMapSvg">${buildMindMapSVG(map)}</div>`;modal.classList.add('show');playHappyMelody();}
  else{title.textContent=`سورة ${surah.name}`;body.innerHTML=`<div class="map-not-available"><div class="icon">🗺️</div><div class="title">خريطة سورة ${surah.name} قريباً</div><div class="desc">نعمل على إضافة خرائط ذهنية تدريجياً</div><button class="btn btn-gold" onclick="window.open('https://www.google.com/search?q=خريطة+ذهنية+سورة+${encodeURIComponent(surah.name)}', '_blank')">🔍 ابحث عن خريطة</button></div>`;modal.classList.add('show');}
}
function closeMapModal(){document.getElementById('mapModal').classList.remove('show');}
document.getElementById('mapModal')?.addEventListener('click',function(e){if(e.target===this)closeMapModal();});
function downloadMap(){const svgEl=document.querySelector('#currentMapSvg svg');if(!svgEl){showToast('⚠️ لا توجد خريطة');return;}const svgData=new XMLSerializer().serializeToString(svgEl);const canvas=document.createElement('canvas');const ctx=canvas.getContext('2d');const img=new Image();canvas.width=1800;canvas.height=1200;img.src='data:image/svg+xml;base64,'+btoa(unescape(encodeURIComponent(svgData)));img.onload=()=>{ctx.fillStyle='#ffffff';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0,canvas.width,canvas.height);const a=document.createElement('a');a.href=canvas.toDataURL('image/png');a.download=`خريطة_${document.getElementById('mapTitle').textContent}.png`;a.click();showToast('📷 تم حفظ الخريطة');};}
function printMap(){const svgEl=document.querySelector('#currentMapSvg svg');if(!svgEl){showToast('⚠️ لا توجد خريطة');return;}const title=document.getElementById('mapTitle').textContent;const svgData=new XMLSerializer().serializeToString(svgEl);const w=window.open('','_blank');w.document.write(`<html dir="rtl"><head><title>${title}</title><link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&display=swap" rel="stylesheet"><style>body{font-family:Amiri,serif;padding:30px;text-align:center;background:#fff;}h1{color:#00897b;margin-bottom:20px;}svg{max-width:100%;height:auto;}</style></head><body><h1>${title}</h1>${svgData}<p style="margin-top:20px;font-size:.85rem;color:#666;">بيت القرآن — © AhmdSchool</p></body></html>`);w.document.close();setTimeout(()=>w.print(),500);}

// ============ المظهر ============
function toggleTheme(){
  currentTheme=currentTheme==='light'?'dark':'light';
  document.body.classList.toggle('dark-mode',currentTheme==='dark');
  try{localStorage.setItem('quran_theme',currentTheme);}catch(e){}
  const btn=document.querySelector('.fab-theme');if(btn)btn.firstChild.nodeValue=currentTheme==='dark'?'☀️':'🌙';
  showToast(currentTheme==='dark'?'🌙 المظهر الليلي':'☀️ المظهر النهاري');
}

// ============ التهيئة ============
function initApp(){
  try{
    const savedTheme=localStorage.getItem('quran_theme');
    if(savedTheme==='dark'){currentTheme='dark';document.body.classList.add('dark-mode');}
    const btn=document.querySelector('.fab-theme');if(btn)btn.firstChild.nodeValue=currentTheme==='dark'?'☀️':'🌙';
    loadMemorized();loadUserData();
    createTabs();renderSurahs();populateSurahSelect();
    console.log('✅ بيت القرآن — 30 خريطة + موسوعة الحفاظ');
  }catch(e){console.error('❌',e);}
}
window.addEventListener('beforeunload',stopAudio);
window.addEventListener('pagehide',stopAudio);
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initApp);
else initApp();
</script>
