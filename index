  const wikiName = WIKI_SURAH_NAMES[num] || `سورة ${meta.name}`;
  const wikiUrl = `https://ar.wikipedia.org/wiki/${encodeURIComponent(wikiName)}`;
  
  try {
    const apiUrl = `https://ar.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(wikiName)}`;
    const res = await fetch(apiUrl);
    if(!res.ok) throw new Error('not found');
