function answerKids(btn,chosen,q){
  document.querySelectorAll('.kids-option').forEach(b=>b.disabled=true);
  const isCorrect=chosen===q.correct;const userName=userData.name||'يا بطل';
  kidsAnswersLog.push({question:q.q,correct:q.options[q.correct],chosen:q.options[chosen],isCorrect});
  if(isCorrect){
    btn.classList.add('correct');kidsCorrect++;kidsScore+=10;updateKidsStats();
    playHappyMelody();launchConfetti();
    showCelebrationBadge(`🎉 أحسنت يا ${userName}! 🎉`);
    setTimeout(()=>speakPraise(`أحسنت يا ${userName}`),300);
  }else{
    btn.classList.add('wrong');kidsWrong++;kidsScore=Math.max(0,kidsScore-3);updateKidsStats();
    playSadMelody();
